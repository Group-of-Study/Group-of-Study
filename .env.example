# =============================================================================
# Group of Study — variáveis de ambiente (placeholders)
# =============================================================================
# Copie este arquivo:  cp .env.example .env
# Preencha os valores. Nunca commite o arquivo .env.
#
# O Compose (compose.yaml / compose.prod.yaml) lê estas variáveis do .env.
# Não duplique segredos dentro dos arquivos Compose.
# =============================================================================

# --- PostgreSQL (serviço `postgres` no Compose) ---
POSTGRES_USER=gos
POSTGRES_PASSWORD=change_me
POSTGRES_DB=group_of_study
# Porta publicada no HOST (somente 127.0.0.1). Dentro da rede Docker a porta é sempre 5432.
# Se 5432 estiver ocupada/bloqueada no Windows, use outra (ex.: 5433) e alinhe DATABASE_URL.
POSTGRES_PORT=5432

# --- URL do banco ---
#
# FORA do Docker (Prisma/npm no host, ferramentas locais):
#   use o host `localhost` e a porta publicada (POSTGRES_PORT).
#
# DENTRO do contêiner `app` (Compose):
#   o hostname do banco é o nome do serviço: `postgres` (não use localhost).
#   O compose.yaml monta DATABASE_URL automaticamente com host `postgres`.
#
# Use esta URL no host (localhost). Ajuste USER/PASSWORD/DB se mudar acima.
DATABASE_URL=postgresql://gos:change_me@localhost:5432/group_of_study?schema=public

# --- Better Auth ---
# Gere um segredo por dev:  openssl rand -base64 32
BETTER_AUTH_SECRET=generate_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# --- Produção (compose.prod.yaml; opcional) ---
# APP_PORT=3000
