// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
  CLOSED
}

enum GoalStatus {
  PENDING
  COMPLETED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  GROUP_REMOVED
  BECAME_LEADER
  GROUP_INVITE
}

// Audit log (GOS-037): ações sensíveis registradas em src/backend/lib/audit-log.ts.
enum AuditAction {
  GROUP_ARCHIVED
  GROUP_MEMBER_REMOVED
  GROUP_LEADER_TRANSFERRED
  ACCOUNT_DELETED
}

enum AuditTargetType {
  GROUP
  USER
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  // 2FA (GOS-034): só vira true depois que a pessoa confirma o primeiro código.
  twoFactorEnabled Boolean?    @default(false)
  image            String?
  // Onboarding "Primeiros passos" (GOS-040): quando a pessoa pulou ou concluiu.
  // Preenchido, o checklist do Início não aparece mais, em nenhum aparelho.
  onboardingDoneAt DateTime?
  // Exclusão de conta (GOS-036): preenchido quando a pessoa exclui a conta. Nome e
  // e-mail já são anonimizados na hora; a linha some de vez depois do prazo
  // (purgeDeletedAccounts em src/backend/features/account/deletion.ts).
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         Session[]
  twoFactors       TwoFactor[]
  accounts         Account[]

  createdGroups   Group[]       @relation("GroupCreator")
  ledGroups       Group[]       @relation("GroupLeader")
  receivedInvites GroupInvite[] @relation("GroupInviteRecipient")

  notifications  Notification[]
  studySessions  StudySession[] @relation("StudySessionCreator")
  memberships    GroupMember[]
  authoredGoals  Goal[]         @relation("GoalAuthor")
  createdInvites GroupInvite[]  @relation("GroupInviteCreator")

  @@index([deletedAt])
  @@map("user")
}

// Plugin twoFactor do Better Auth (GOS-034). secret e backupCodes ficam
// criptografados pelo próprio Better Auth (com o BETTER_AUTH_SECRET).
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  // false enquanto a pessoa não confirmou o primeiro código do app.
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Group {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  status      GroupStatus @default(ACTIVE)

  creatorId  String?
  creator    User?           @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  leaderId   String?
  leader     User?           @relation("GroupLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  visibility GroupVisibility @default(PUBLIC)

  invites       GroupInvite[]
  members       GroupMember[]
  goals         Goal[]
  studySessions StudySession[]

  @@index([creatorId])
  @@index([leaderId])
  @@index([status])
  @@map("study_group")
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("group_member")
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      GoalStatus @default(PENDING)
  // Quando foi concluída ("Concluída hoje", ritmo da semana). Volta a null se a meta
  // for reaberta.
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  groupId  String
  authorId String?

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User? @relation("GoalAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([authorId])
  @@map("study_goal")
}

// Agenda do grupo (GOS-042): encontros de estudo marcados pelo líder.
model StudySession {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  // Onde: um lugar ("Biblioteca, sala 3"), um link (Meet, Discord...) ou os dois.
  location    String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupId     String
  createdById String?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation("StudySessionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([groupId, startsAt])
  @@index([createdById])
  @@map("study_session")
}

model GroupInvite {
  id        String    @id @default(cuid())
  code      String    @unique
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  groupId     String
  createdById String?
  recipientId String?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User? @relation("GroupInviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  recipient User? @relation("GroupInviteRecipient", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([groupId, revokedAt])
  @@index([createdById])
  @@index([recipientId])
  @@index([expiresAt])
  @@map("group_invite")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

// Audit log (GOS-037). Só se acrescenta linha: nada aqui é editado ou apagado pelo app.
// actorId e targetId não têm chave estrangeira de propósito: o registro precisa
// continuar existindo (e apontando para o mesmo id) depois que o grupo ou a conta
// somem (ex.: purgeDeletedAccounts, GOS-036). Por isso também nada de nome ou e-mail
// em metadata: só ids, que não identificam ninguém depois da anonimização.
model AuditLog {
  id         String          @id @default(cuid())
  action     AuditAction
  // Quem fez a ação.
  actorId    String
  targetType AuditTargetType
  targetId   String
  // Detalhes da ação (ex.: quem foi removido, o novo líder). Só ids.
  metadata   Json?
  // Mesmo IP que o Better Auth grava na sessão (getIP); null quando não dá para saber.
  ipAddress  String?
  createdAt  DateTime        @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_log")
}
