# syntax=docker/dockerfile:1
# Desenvolvimento: next dev com hot reload.
# No Compose, o código é bind-mounted; node_modules fica em volume anônimo.

ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma7.config.ts ./

# Necessário para o postinstall (`prisma generate --config prisma7.config.ts`)
ENV DATABASE_URL="postgresql://build:build@127.0.0.1:5432/build?schema=public"

RUN npm ci

COPY . .

# Hot reload confiável com bind mount no Windows (Docker Desktop)
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

EXPOSE 3000

# Regenera o client (src/generated é gitignored e some no bind mount do host)
# e sobe o servidor de desenvolvimento escutando em todas as interfaces.
CMD ["sh", "-c", "npx prisma generate --config prisma7.config.ts && npm run dev -- -H 0.0.0.0 -p 3000"]
